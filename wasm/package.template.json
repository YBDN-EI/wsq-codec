{
  "name": "wsq-codec",
  "version": "@VERSION@",
  "description": "Decode and encode WSQ (Wavelet Scalar Quantization) fingerprint images in the browser or Node.js: WebAssembly build of the pure-Rust wsq-codec",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ybdn/wsq-codec.git",
    "directory": "wasm"
  },
  "homepage": "https://github.com/ybdn/wsq-codec/tree/main/wasm#readme",
  "bugs": "https://github.com/ybdn/wsq-codec/issues",
  "keywords": ["wsq", "fingerprint", "biometrics", "wasm", "webassembly", "image", "codec"],
  "main": "nodejs/wsq_codec.js",
  "module": "bundler/wsq_codec.js",
  "types": "bundler/wsq_codec.d.ts",
  "exports": {
    ".": {
      "types": "./bundler/wsq_codec.d.ts",
      "node": "./nodejs/wsq_codec.js",
      "default": "./bundler/wsq_codec.js"
    },
    "./web": {
      "types": "./web/wsq_codec.d.ts",
      "default": "./web/wsq_codec.js"
    },
    "./web/wsq_codec_bg.wasm": "./web/wsq_codec_bg.wasm",
    "./package.json": "./package.json"
  },
  "sideEffects": ["./bundler/wsq_codec.js", "./bundler/snippets/*"],
  "files": [
    "bundler/",
    "nodejs/",
    "web/",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
